[flake8]
max-line-length = 120
exclude = external/*,.venv/*,.git/*,build/*,dist/*

# Pre-existing issues — silenced per-file until cleaned incrementally
# TODO(#tech-debt): incrementally remove these ignores
per-file-ignores =
    tests/*.py: E402, E712, F401, F841, E203
    tools/*.py: E402, F401, F811, W391
    src/testing/*.py: E402, F401
    src/ui/__init__.py: F401
    src/ui/theme.py: F401
    src/app.py: F403, F401, F841, F541, E402, E231
    src/core/__init__.py: F401
    src/core/fragment_combinations.py: F541, E722
    src/core/fragments.py: F401
    src/core/pipeline.py: F401, E712
    src/core/spectrum_ops.py: F401, E712
    src/core/rdkit_bridge.py: E722, F541
    src/core/benchmark.py: F841
    src/core/chemistry/__init__.py: F401
    src/core/chemistry/fragments.py: E402, E302, F401
    src/core/chemistry/rdkit_bridge.py: F821
    src/core/domain/spectrum.py: F401
    src/core/formula_db/__init__.py: F401
    src/core/formula_db/*.py: F401, E701, E203
    src/core/pipeline/__init__.py: F401
    src/core/pipeline/_cache.py: F401, E231
    src/core/pipeline/_helpers.py: F401
    src/core/pipeline/_run.py: F401, E401, F821, E712
    src/core/pipeline/_test.py: F401, E401, E712, F821
    src/core/spectrum/__init__.py: F401
    src/core/spectrum/_assign.py: F401, F821
    src/core/spectrum/_build.py: F401, E712
    src/core/spectrum/_chem.py: F401
    src/core/spectrum/_constants.py: F401
    src/core/spectrum/_denoise.py: F401, F841, E203
    src/core/spectrum/_generate.py: F401
    src/core/spectrum/_load.py: F401
    src/core/spectrum/_series.py: F401
    src/core/spectrum/_visualize.py: F401, F821
    src/sim/generate_test_sets.py: E402, F401
    src/sim/process_pubchem_candidates.py: F401
    src/simulations/generate_test_sets.py: F811, F401
    src/simulations/process_pubchem_candidates.py: F401
    src/ui/_build.py: F401, E401, F821
    src/ui/_config.py: F401
    src/ui/_log.py: F401, E401
    src/ui/_params.py: F401, E401, F821
    src/ui/_plots.py: F401, E401, F821, F841, E231
    src/ui/_presets.py: F401, E401, F811
    src/ui/_results.py: F401, E401
    src/ui/_run.py: F401, E401, F821
    src/ui/_structures.py: F401, E401
    src/ui/_tabs.py: F401, E401
    src/structures/__init__.py: F401, F811
    src/structures/rdkit_utils.py: F403, F405
    src/structures/tab.py: F403, F405, F401, F841
    src/structures/widgets.py: F401, F403, F405
