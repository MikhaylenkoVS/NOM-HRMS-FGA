  "scope": {
    "allowed_paths": [
      "pyproject.toml",
      "MANIFEST.in",
      "requirements.txt",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "tools/NOM_HRMS_FGA.spec",
